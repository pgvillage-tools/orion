ARG VERSION=v0.0.0-devel

# Build on the native platform of the builder and cross-compile for the target platform.
# TARGETOS and TARGETARCH are set by buildx (from --platform), and must not have a default here,
# or that default overrides the value from buildx and every image ends up with the same binary.
FROM --platform=$BUILDPLATFORM docker.io/golang:1.27-bookworm AS builder

ARG TARGETOS
ARG TARGETARCH
ARG VERSION

WORKDIR /workspace
# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum

# Copy the go source
COPY api/ api/
COPY cmd/ cmd/
COPY internal/ internal/
COPY pkg/ pkg/

# Build
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -v -a \
    -ldflags="-X 'github.com/pgvillage-tools/orion/cmd.Version=$VERSION'" -o orion-api ./cmd/api

FROM docker.io/debian:bookworm-slim

LABEL MAINTAINER=Nibble-IT

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /
COPY --from=builder /workspace/orion-api ./

# The api needs its certificates (as created by orion-cli pki init) in ORIONAPI_PKI_DIR
ENV ORIONAPI_CLUSTER_NAME=orion \
    ORIONAPI_STORE_BACKEND=etcdv3 \
    ORIONAPI_PKI_DIR=/etc/orion/api

RUN useradd orion
USER orion

# 8443: the api (TLS, a client certificate is required), 8080: /livez, /readyz, /status and /metrics
EXPOSE 8443 8080

ENTRYPOINT ["/orion-api"]
