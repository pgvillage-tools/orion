ARG VERSION=v0.0.0-devel
ARG PGVERSION=18

# Build on the native platform of the builder and cross-compile for the target platform.
# TARGETOS and TARGETARCH are set by buildx (from --platform), and must not have a default here,
# or that default overrides the value from buildx and every image ends up with the same binary.
FROM --platform=$BUILDPLATFORM docker.io/golang:bookworm AS builder

ARG TARGETOS
ARG TARGETARCH
ARG VERSION

WORKDIR /workspace
# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum

# Copy the go source
COPY api/ api/
COPY cmd/ cmd/
COPY internal/ internal/
COPY pkg/ pkg/

# Build
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -v -a -ldflags="-X 'github.com/pgvillage-tools/orion/cmd.Version=$VERSION'" -o orion-keeper ./cmd/keeper

FROM docker.io/postgres:${PGVERSION}
ARG PGVERSION=18

LABEL MAINTAINER=Nibble-IT

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /
COPY --from=builder /workspace/orion-keeper ./

RUN mkdir /pgdata /pgwal && chown postgres: /pgdata /pgwal

ENV ORIONKEEPER_PG_BIN_PATH=/usr/lib/postgresql/${PGVERSION}/bin \
    ORIONKEEPER_CLUSTER_NAME=orion \
    ORIONKEEPER_STORE_BACKEND=etcdv3 \
    ORIONKEEPER_DATA_DIR=/pgdata \
    ORIONKEEPER_PGDATA_DIR=/pgdata/pgdata \
    ORIONKEEPER_WAL_DIR=/pgwal/pgwal \
    ORIONKEEPER_PG_PORT=5432 \
    ORIONKEEPER_PG_REPL_USERNAME=postgres

ENTRYPOINT ["/orion-keeper"]
USER postgres
